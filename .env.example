# Copy to .env and adjust:  cp .env.example .env
# Docker Compose reads .env automatically. Never commit the real .env.

# Compose project name (prefix for containers, networks and volumes)
COMPOSE_PROJECT_NAME=taskboard

# --- Frontend (nginx) ---
# Host port the app is published on: http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080

# --- API (Node.js / Express) ---
APP_NAME=Taskboard
APP_VERSION=1.0.0
API_PORT=3000
LOG_LEVEL=info
DB_POOL_MAX=10

# --- Database (PostgreSQL) ---
POSTGRES_DB=taskboard
POSTGRES_USER=taskboard
# Example value only. Change it before running anywhere shared.
POSTGRES_PASSWORD=change-me-please

# --- Optional tools profile (Adminer DB UI) ---
ADMINER_PORT=8081
